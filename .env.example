# Dorothy Configuration
# Copy to .env and fill in your values

# =============================================================================
# LLM Service (synthesis ordering, event-thread confirmation)
# OpenAI-compatible API — LMStudio on the tailnet by default
# =============================================================================
LLM_BASE_URL=http://macstudio.tail.cmm.sh:1234
LLM_MODEL=liquid/lfm2-1.2b
# Prepend an empty <think></think> turn (needed for Qwen "thinking" models;
# MUST be false for LiquidAI LFM2)
LLM_SKIP_THINKING=false

# =============================================================================
# Embedding Service (clustering, event-thread matching)
# =============================================================================
EMBEDDING_BASE_URL=http://macstudio.tail.cmm.sh:1234
EMBEDDING_MODEL=text-embedding-mxbai-embed-large-v1

# =============================================================================
# Clustering (daily-paper window)
# =============================================================================
# Only articles published within this window enter clustering
CLUSTERING_WINDOW_HOURS=72
# Per-cycle cap of articles per source per column (archive-dump guard)
CLUSTERING_MAX_PER_SOURCE=40
CLUSTERING_MIN_CLUSTER_SIZE=3
CLUSTERING_MIN_SAMPLES=2
# "leaf" extracts tight clusters; "eom" collapses dense columns into blobs
CLUSTERING_CLUSTER_SELECTION_METHOD=leaf

# =============================================================================
# Event Threads (long-running story tracking)
# =============================================================================
EVENTS_ENABLED=true
# Cosine floor for the thread-candidate shortlist
EVENTS_SHORTLIST_THRESHOLD=0.60
EVENTS_SHORTLIST_K=3
# Active threads with no development for this many days go dormant
EVENTS_DORMANT_AFTER_DAYS=14
# Threadless stories this recent are recurrence-birth candidates
EVENTS_THREADLESS_WINDOW_DAYS=14

# =============================================================================
# AWS / S3 Deployment
# =============================================================================
S3_BUCKET=dorothy-cmm-sh
AWS_REGION=us-east-1
# CloudFront distribution ID (optional, for cache invalidation)
CLOUDFRONT_ID=
# AWS credentials (optional if using ~/.aws/credentials or IAM roles)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# OpenSearch
# =============================================================================
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false

# =============================================================================
# Pipeline Settings
# =============================================================================
SCHEDULER_FETCH_INTERVAL_MINUTES=60
FETCHER_BATCH_SIZE=50
FETCHER_TIMEOUT=30
