# Dorothy Configuration
# Copy to .env and fill in your values

# =============================================================================
# LLM Service (for synthesis, via Ollama)
# =============================================================================
# URL of your Ollama server
LLM_BASE_URL=http://192.168.0.149:11434

# Model to use for synthesis
LLM_MODEL=qwen3.5:27b

# =============================================================================
# Article Quality Reviewer (via Ollama, separate model)
# =============================================================================
# URL of Ollama server for review pass (can be same as LLM)
REVIEWER_BASE_URL=http://192.168.0.149:11434

# Model to use for article quality review
REVIEWER_MODEL=gemma4:31b

# Enable/disable the review pass
REVIEWER_ENABLED=true

# =============================================================================
# Embedding Service (for clustering, via Ollama)
# =============================================================================
# URL of your Ollama server for embeddings
EMBEDDING_BASE_URL=http://192.168.0.149:11434

# Embedding model name
EMBEDDING_MODEL=mxbai-embed-large

# =============================================================================
# AWS / S3 Deployment
# =============================================================================
# S3 bucket for static site hosting
S3_BUCKET=dorothy-news

# AWS region
AWS_REGION=us-east-1

# CloudFront distribution ID (optional, for cache invalidation)
CLOUDFRONT_ID=

# AWS credentials (optional if using ~/.aws/credentials or IAM roles)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# =============================================================================
# OpenSearch
# =============================================================================
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false

# =============================================================================
# Pipeline Settings
# =============================================================================
SCHEDULER_FETCH_INTERVAL_MINUTES=60
FETCHER_BATCH_SIZE=50
FETCHER_TIMEOUT=30
